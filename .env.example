# ============================================================================
# Automation-excel-daily — environment variables
# ----------------------------------------------------------------------------
# Copy this file to `.env` (never commit) and fill in the values.
# ============================================================================

# -------- Sprout Social API ----------
SPROUT_CUSTOMER_ID=2653573
# Token from Sprout admin → Settings → API Access. Rotate regularly.
SPROUT_API_TOKEN=

# -------- Google Drive output folder ----------
# The Drive folder ID where every "Copy of <Group>" spreadsheet lives.
DRIVE_FOLDER_ID=13XPLx5l1LuPeJL2Ue03ZztNQUsNgNW06

# -------- Google Auth ----------
# Preferred: point to the service account JSON file.
# This is what googleAuth.js uses (ADC-first).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Optional legacy fallback (used only if GOOGLE_APPLICATION_CREDENTIALS is unset).
# If you use this, both vars must be set together.
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=

# Optional — only if you run the OAuth flow (legacy test-oauth.js):
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth2callback

# -------- Completion email (Gmail app password) ----------
# Generate an "App Password" at https://myaccount.google.com/apppasswords.
# Do NOT use the account password.
GMAIL_USER=satharva2004@gmail.com
GMAIL_APP_PASSWORD=

# Optional: override the From header (defaults to GMAIL_USER)
# MAIL_FROM=

# Comma-separated list of recipients for the completion email.
MAIL_RECIPIENTS=atharva.sawant@schbang.com,ansh.shetty@schbang.com,yadnesh.rane@schbang.com
