{
  "name": "sprout-analytics-to-sheets",
  "version": "1.0.0",
  "description": "Pulls analytics from Sprout Social API and writes per-group Google Sheets. Runs daily on EC2 via cron.",
  "main": "bin/run.js",
  "bin": {
    "sprout-analytics": "bin/run.js"
  },
  "scripts": {
    "start": "node bin/run.js",
    "profile": "node bin/run.js --pipeline=profile",
    "posts": "node bin/run.js --pipeline=posts",
    "test": "echo \"No tests yet — see REFACTOR_PLAN.md Phase 8\" && exit 0"
  },
  "keywords": [
    "sprout",
    "social",
    "analytics",
    "google-sheets",
    "cron"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.9.0",
    "dotenv": "^17.2.1",
    "googleapis": "^148.0.0",
    "nodemailer": "^6.9.14"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
